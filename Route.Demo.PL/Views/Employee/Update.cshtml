@model UpdatedDepartmentDto

@{
    ViewData["Title"] = "Update";
}
<h1> Update Department</h1>
<br />
<br />
    <form method="post" asp-controller="Department" asp-action="Update" >
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-group">

            <label class="col-form-label" asp-for="Code"></label>
            <input type="text"  asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="form-group ">
            <label class="col-form-label" asp-for="Name"></label>
        <input type="text"  asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group mb-3"> 
            <label class="form-label" asp-for="Description"></label> 
            <textarea class="form-control" asp-for="Description"></textarea>
         </div>
    <div class="form-group ">
        <label class="col-form-label" asp-for="CreateOn"></label>
        <input type="date" asp-for="CreateOn" class="form-control" />

    </div>


        <div >
            <input class="btn btn-success" type="submit" value="Update" />
            <a asp-action="Index" class="btn btn-outline-dark">Back to list</a>
        </div>
    </form>
</div>
</div>